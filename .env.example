# ------------------------------------------------------------------
# Export OS - Environment Configuration
# Copy this file to .env.local and fill in your own values.
# Never commit real secrets.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Supabase (Project URL + keys)
# Create a project at https://supabase.com, run supabase/migrations
# and supabase/seed.sql in the SQL editor.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side service role key (NEVER exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base host for tenant websites, e.g. company.exportos.com
NEXT_PUBLIC_SITE_BASE_HOST=exportos.com
# Secret used to sign the per-tenant public-site token (JWT)
PUBLIC_SITE_JWT_SECRET=generate-a-long-random-secret

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
# Comma separated list of allowed callback origins for email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com)
# ------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Optional webhook secret for verifying Razorpay webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ------------------------------------------------------------------
# Amazon SES (https://aws.amazon.com/ses)
# ------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_SES_FROM_EMAIL=no-reply@exportos.com

# ------------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Preferred provider: "openai" | "anthropic"
AI_PROVIDER=openai

# ------------------------------------------------------------------
# Docker / Production
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exportos
# Encryption key for storing secrets at rest (32 bytes hex, use: openssl rand -hex 32)
ENCRYPTION_KEY=
